# Copy to .env.local and fill in for your deployment. Nothing else needs
# to change in code to point this frontend at a new venue's backend.

# The backend API's base URL. Inlined into the client bundle at build
# time (NEXT_PUBLIC_ vars are - never put a real secret in one).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Must exactly match the backend's JWT_SECRET - proxy.ts verifies the same
# signed token server-side, with no network hop back to the API.
# Server-only (no NEXT_PUBLIC_ prefix), never sent to the browser.
JWT_SECRET=
